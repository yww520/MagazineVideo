# 302.ai OpenAI-compatible chat API
# 国内请用 api.302ai.cn；api.302.ai 在部分网络会因 DNS 污染连不上
LLM_BASE_URL=https://api.302ai.cn/v1
LLM_API_KEY=
LLM_MODEL=gemini-3.7-flash

# Local API
PORT=8787

# YouTube 下载 403 时可选：导出 cookies.txt，或指定已登录的浏览器
# YTDLP_COOKIES=/absolute/path/to/cookies.txt
# YTDLP_COOKIES_FROM_BROWSER=chrome
